#!/usr/bin/env python3
"""crn — Cairn CLI. Your work as a graph of markdown nodes; iwe does the graph, crn adds the work verbs.

  crn init <dir>                 scaffold an empty bundle (iwe --okf + Cairn schemas + cairn.toml)
  crn find <words>               ranked search over nodes (title, state, body)
  crn open <node>                one node with its links; <node> = key, bare number, or slug prefix
  crn pending                    work nodes whose stage is active, parked or blocked, most recent first
  crn state <node> "<sentence>"  set the one-line state
  crn stage <node> <stage>       active | parked | blocked | done
  crn log <node> "<text>"        append a dated line under ## Log
  crn decide <node> "<text>"     append a dated line under ## Decisions
  crn sweep [--fixture F] [--create]   refresh gh_* fields from GitHub (or a fixture); list issues with no node
  crn trail                      fold new Claude Code transcripts into ## Log (one line per session per node)
  crn validate                   iwe schema validate
  crn systems                    system nodes with the number of work nodes linking to them

Bundle = $CAIRN_BUNDLE, else the nearest parent of the cwd containing cairn.toml.
Never calls a model. Writes only inside the bundle. GitHub is read-only.
"""
import json, os, re, subprocess, sys, shutil, tomllib
from datetime import datetime, timezone, date
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
TODAY = date.today().isoformat()
NOW = datetime.now(timezone.utc)

# ------------------------------------------------------------------ bundle + config
def find_bundle():
    if os.environ.get("CAIRN_BUNDLE"): return Path(os.environ["CAIRN_BUNDLE"]).resolve()
    p = Path.cwd().resolve()
    for d in [p, *p.parents]:
        if (d / "cairn.toml").exists(): return d
    die("no bundle: set CAIRN_BUNDLE or run inside a directory with cairn.toml (crn init <dir>)")

def config(bundle):
    with open(bundle / "cairn.toml", "rb") as f: return tomllib.load(f)

def die(msg, rc=2): print(f"crn: {msg}", file=sys.stderr); sys.exit(rc)

def iwe(bundle, *args, check=True, inp=None):
    p = subprocess.run(["iwe", *args], cwd=bundle, capture_output=True, text=True, input=inp)
    if check and p.returncode != 0: die(f"iwe {' '.join(args[:2])} failed: {(p.stderr or p.stdout).strip()[:400]}", p.returncode)
    return p.stdout

def iwe_json(bundle, *args):
    out = iwe(bundle, *args, "--format", "json")
    return json.loads(out) if out.strip() else []

def nodes(bundle, flt=None):
    args = ["find", "--limit", "0"]
    if flt: args += ["--filter", flt]
    return iwe_json(bundle, *args)

def fm(n): return n.get("frontmatter") or n.get("fm") or {k: v for k, v in n.items() if k not in ("key", "title", "content", "$content")}

def key_of(n): return n.get("key") or n.get("$key")

# ------------------------------------------------------------------ resolve
def resolve(bundle, s):
    s = s.strip().rstrip("/")
    allk = {key_of(n): n for n in nodes(bundle)}
    if s in allk: return s
    for pre in ("work/", "systems/", "people/"):
        if pre + s in allk: return pre + s
    if s.isdigit() or "#" in s:
        num = s.split("#")[-1]
        hits = [k for k, n in allk.items() if k.startswith("work/") and (str(fm(n).get("resource", "")).rstrip("/").endswith("/" + num) or k.endswith("-" + num))]
        if len(hits) == 1: return hits[0]
    hits = [k for k in allk if k.split("/")[-1].startswith(s)]
    if len(hits) == 1: return hits[0]
    if len(hits) > 1: die("ambiguous: " + ", ".join(sorted(hits)[:8]), 1)
    die(f"no node matches '{s}'; try: crn find {s}", 1)

# ------------------------------------------------------------------ verbs
def cmd_init(a):
    if not a: die("usage: crn init <dir>")
    d = Path(a[0]).resolve(); d.mkdir(parents=True, exist_ok=True)
    if (d / "cairn.toml").exists(): die(f"{d} already has cairn.toml")
    subprocess.run(["iwe", "init", "--okf", "--auto"], cwd=d, check=True, capture_output=True)
    sd = d / ".iwe" / "schemas"
    for s in ("work", "system", "person"): shutil.copy(HERE / "schemas" / f"{s}.yaml", sd / f"{s}.yaml")
    cfg = d / ".iwe" / "config.toml"
    cfg.write_text(cfg.read_text() + '\n[schemas.work]\nmatch = "work/**"\n\n[schemas.system]\nmatch = "systems/**"\n\n[schemas.person]\nmatch = "people/**"\n')
    for sub in ("work", "systems", "people"): (d / sub).mkdir(exist_ok=True)
    (d / "cairn.toml").write_text((HERE / "examples" / "cairn.example.toml").read_text())
    (d / ".cairn").mkdir(exist_ok=True)
    print(f"bundle ready: {d}\nedit cairn.toml, then: crn find / crn pending / crn sweep")

def cmd_find(bundle, a):
    if not a: die("usage: crn find <words>")
    q = " ".join(a)
    rows = iwe_json(bundle, "find", "--lexical", q, "--fuzzy", q, "--limit", "12")
    if not rows: print("no matches"); return 1
    for n in rows:
        f = fm(n); k = key_of(n); kind = f.get("type", "?")
        line = f"{kind:7s} {k:34s} {n.get('title', '')[:60]}"
        if kind == "work": line += f"\n        {f.get('stage', '')} · {str(f.get('state', ''))[:90]}"
        print(line)
    return 0

def cmd_open(bundle, a):
    if not a: die("usage: crn open <node>")
    k = resolve(bundle, a[0])
    f = next((fm(n) for n in nodes(bundle) if key_of(n) == k), {})
    if f.get("type") == "work":
        print(f"{k} · {f.get('stage')} · updated {str(f.get('updated', ''))[:10]} · gh {f.get('gh_state', '?')} {str(f.get('gh_updated', ''))[:10]} last {f.get('last_actor', '?')}")
        print(f"state: {f.get('state')}")
        meta = [f"{x} {', '.join(f[x])}" for x in ("env", "systems", "people", "blocked_by") if f.get(x)]
        if meta: print(" · ".join(meta))
        print()
    print(iwe(bundle, "retrieve", "-k", k).rstrip())
    back = iwe(bundle, "find", "--references", k, "--format", "keys").split()
    back = [b for b in back if b != k]
    if back: print(f"\nlinked from ({len(back)}): " + " · ".join(back[:12]))
    return 0

def cmd_pending(bundle, a):
    rows = [n for n in nodes(bundle, "type: work") if fm(n).get("stage") in ("active", "parked", "blocked")]
    rows.sort(key=lambda n: str(fm(n).get("updated", "")), reverse=True)
    if not rows: print("nothing pending"); return 0
    for n in rows:
        f = fm(n)
        print(f"{f.get('stage', ''):7s} {key_of(n):34s} {str(f.get('updated', ''))[:10]}  {str(f.get('state', ''))[:80]}")
    return 0

def append_line(bundle, k, header, text):
    iwe(bundle, "update", "-k", k, "--expect", "1", "--set", f"updated={TODAY}",
        "--append", json.dumps({"$header": header, "content": f"- {TODAY} {text}"}))

def cmd_state(bundle, a):
    if len(a) < 2: die('usage: crn state <node> "<sentence>"')
    k = resolve(bundle, a[0]); text = " ".join(a[1:])
    iwe(bundle, "update", "-k", k, "--expect", "1", "--set", f"state={json.dumps(text)}", "--set", f"updated={TODAY}")
    print(f"{k}: state set"); return 0

def cmd_stage(bundle, a):
    if len(a) != 2 or a[1] not in ("active", "parked", "blocked", "done"): die("usage: crn stage <node> active|parked|blocked|done")
    k = resolve(bundle, a[0]); iwe(bundle, "update", "-k", k, "--expect", "1", "--set", f"stage={a[1]}", "--set", f"updated={TODAY}")
    print(f"{k}: stage {a[1]}"); return 0

def cmd_log(bundle, a):
    if len(a) < 2: die('usage: crn log <node> "<text>"')
    k = resolve(bundle, a[0]); append_line(bundle, k, "Log", " ".join(a[1:])); print(f"{k}: logged"); return 0

def cmd_decide(bundle, a):
    if len(a) < 2: die('usage: crn decide <node> "<text>"')
    k = resolve(bundle, a[0]); append_line(bundle, k, "Decisions", " ".join(a[1:])); print(f"{k}: decision recorded"); return 0

# ------------------------------------------------------------------ producers
ISSUE_URL = re.compile(r"github\.com/([^/]+)/([^/]+)/(?:issues|pull)/(\d+)")

def gh_items(cfg, fixture):
    """Return {(owner, repo, number): {state, updated, last_actor, title, url}} from a fixture or GitHub."""
    if fixture:
        data = json.loads(Path(fixture).read_text())
        return {(i["owner"], i["repo"], int(i["number"])): i for i in data["items"]}
    gh = cfg.get("github", {}); user = gh.get("user"); org = gh.get("org")
    if not (user and org): die("cairn.toml needs [github] org and user for a live sweep (or use --fixture)")
    out = subprocess.run(["gh", "search", "issues", "--owner", org, "--assignee", user, "--state", "open", "--json", "repository,number,title,state,updatedAt,url", "--limit", "200"], capture_output=True, text=True)
    if out.returncode != 0: die("gh search failed: " + out.stderr.strip()[:200])
    items = {}
    for i in json.loads(out.stdout):
        repo = i["repository"]["nameWithOwner"].split("/")
        items[(repo[0], repo[1], int(i["number"]))] = {"owner": repo[0], "repo": repo[1], "number": i["number"], "title": i["title"],
                                                        "state": i["state"].lower(), "updated": i["updatedAt"], "last_actor": None, "url": i["url"]}
    return items

def cmd_sweep(bundle, cfg, a):
    fixture = a[a.index("--fixture") + 1] if "--fixture" in a else None
    create = "--create" in a
    items = gh_items(cfg, fixture)
    work = nodes(bundle, "type: work"); seen = set(); changed = []
    for n in work:
        f = fm(n); m = ISSUE_URL.search(str(f.get("resource", "")))
        if not m: continue
        ident = (m.group(1), m.group(2), int(m.group(3))); seen.add(ident)
        it = items.get(ident)
        if not it: continue
        sets = []
        if f.get("gh_state") != it["state"]: sets += ["--set", f"gh_state={it['state']}"]
        if str(f.get("gh_updated", ""))[:19] != str(it["updated"])[:19]: sets += ["--set", f"gh_updated={json.dumps(it['updated'])}"]
        if it.get("last_actor") and f.get("last_actor") != it["last_actor"]: sets += ["--set", f"last_actor={it['last_actor']}"]
        if sets:
            iwe(bundle, "update", "-k", key_of(n), "--expect", "1", *sets); changed.append((key_of(n), it))
    new = [it for ident, it in items.items() if ident not in seen]
    print(f"sweep: {len(items)} items · {len(changed)} node(s) updated · {len(new)} without a node")
    for k, it in changed: print(f"  updated {k}: gh_state={it['state']} gh_updated={str(it['updated'])[:10]}")
    for it in new:
        print(f"  new     {it['owner']}/{it['repo']}#{it['number']} {it['title'][:70]}")
        if create:
            k = f"work/{it['repo']}-{it['number']}"
            body = (f"---\ntype: work\ntitle: {json.dumps(it['title'])}\nstate: \"new from sweep, not yet triaged\"\nstage: active\n"
                    f"resource: {it['url']}\nenv: []\nsystems: []\npeople: []\nblocked_by: []\ngh_state: {it['state']}\ngh_updated: {json.dumps(it['updated'])}\n"
                    f"generated: {{ by: \"crn/sweep\", at: \"{NOW.isoformat(timespec='seconds')}\" }}\nupdated: {TODAY}\n---\n# {it['title']}\n\n"
                    f"## Now\n\nCreated by `crn sweep` on {TODAY}; state not yet written.\n\n## Next\n\n1. Triage.\n\n## Decisions\n\n## Artifacts\n\n## Log\n\n- {TODAY} created by sweep\n")
            iwe(bundle, "create", k, "-c", "-", inp=body); print(f"          created {k}")
    return 0

def cmd_trail(bundle, cfg, a):
    tr = cfg.get("trail", {}); root = Path(os.path.expanduser(tr.get("transcripts", "~/.claude/projects"))); prefix = tr.get("prefix", "")
    if not prefix: die("cairn.toml needs [trail] prefix (the encoded project dir, e.g. -home-me-work-repo)")
    state_p = bundle / ".cairn" / "trail-state.json"; state = json.loads(state_p.read_text()) if state_p.exists() else {"done": {}}
    work = {key_of(n): fm(n) for n in nodes(bundle, "type: work")}
    pats = {}
    for k, f in work.items():
        m = ISSUE_URL.search(str(f.get("resource", "")))
        rx = [re.escape(k), re.escape(k.split("/")[-1])]
        if m: rx += [re.escape(f"{m.group(2)}#{m.group(3)}"), re.escape(f"{m.group(1)}/{m.group(2)}#{m.group(3)}"), re.escape(f"/{m.group(3)}\\b").replace("\\\\b", "\\b")]
        pats[k] = re.compile("|".join(rx))
    files = [p for d in root.iterdir() if d.is_dir() and d.name.startswith(prefix) for p in d.glob("*.jsonl")]
    added = 0
    for p in sorted(files, key=lambda p: p.stat().st_mtime):
        sig = f"{p.stat().st_size}:{int(p.stat().st_mtime)}"
        if state["done"].get(p.stem) == sig: continue
        per = {}; first = last = None
        for line in open(p, errors="replace"):
            try: d = json.loads(line)
            except Exception: continue
            if d.get("type") != "assistant": continue
            ts = d.get("timestamp"); first = first or ts; last = ts or last
            for c in (d.get("message") or {}).get("content", []) or []:
                if not (isinstance(c, dict) and c.get("type") == "tool_use"): continue
                text = json.dumps(c.get("input", {}))[:3000]
                head = (c["input"].get("command") or c["input"].get("file_path") or c.get("name")) if isinstance(c.get("input"), dict) else c.get("name")
                head = re.sub(r"\s+", " ", str(head)).split("<<")[0][:90]
                for k, rx in pats.items():
                    if rx.search(text): per.setdefault(k, []).append(head)
        for k, heads in per.items():
            if k in state["done"].get("__logged__", {}).get(p.stem, []): continue
            day = (first or "")[:10] or TODAY
            uniq = list(dict.fromkeys(heads))[-3:]
            iwe(bundle, "update", "-k", k, "--expect", "1", "--append",
                json.dumps({"$header": "Log", "content": f"- {day} session {p.stem[:8]}: {len(heads)} call(s) · " + " · ".join(f"`{h}`" for h in uniq)}))
            state["done"].setdefault("__logged__", {}).setdefault(p.stem, []).append(k); added += 1
        state["done"][p.stem] = sig
    state_p.write_text(json.dumps(state, indent=1))
    print(f"trail: {len(files)} transcript(s) scanned · {added} log line(s) added"); return 0

def cmd_systems(bundle, a):
    sysn = nodes(bundle, "type: system"); work = nodes(bundle, "type: work")
    for s in sorted(sysn, key=key_of):
        k = key_of(s); slug = k.split("/")[-1]
        n = sum(1 for w in work if slug in (fm(w).get("systems") or []))
        print(f"{n:3d} {k:30s} {s.get('title', '')[:50]}  {str(fm(s).get('access', ''))[:60]}")
    return 0

def main(argv):
    a = list(argv[1:]); cmd = a.pop(0) if a else "help"
    if cmd in ("help", "-h", "--help"): print(__doc__); return 0
    if cmd == "init": return cmd_init(a) or 0
    bundle = find_bundle(); cfg = config(bundle)
    if cmd == "find": return cmd_find(bundle, a)
    if cmd == "open": return cmd_open(bundle, a)
    if cmd == "pending": return cmd_pending(bundle, a)
    if cmd == "state": return cmd_state(bundle, a)
    if cmd == "stage": return cmd_stage(bundle, a)
    if cmd == "log": return cmd_log(bundle, a)
    if cmd == "decide": return cmd_decide(bundle, a)
    if cmd == "sweep": return cmd_sweep(bundle, cfg, a)
    if cmd == "trail": return cmd_trail(bundle, cfg, a)
    if cmd == "systems": return cmd_systems(bundle, a)
    if cmd == "validate": print(iwe(bundle, "schema", "validate", check=False).rstrip() or "valid"); return 0
    print(__doc__); return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv))
